<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares which locales the app explicitly supports, so the system
  "App languages" settings screen (Android 13+) lists French/English
  instead of every locale on the device. Referenced from AndroidManifest.xml
  via android:localeConfig="@xml/locales_config" on the <application> tag —
  see CHANGELOG.md for the exact manifest line to add.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="fr"/>
    <locale android:name="en"/>
</locale-config>
